# Docker Environment Configuration
# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/voting?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Server Configuration
PORT=4000
NODE_ENV=development 

# Development environment variables
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# MinIO Configuration for Local Development (S3-compatible)
STORAGE_PROVIDER=minio
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_REGION=us-east-1
AWS_S3_BUCKET=voting-candidate-images
AWS_S3_BUCKET_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
CDN_BASE_URL=http://localhost:9000

# AWS S3 Configuration for Production (uncomment when going live)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=voting-candidate-images
# AWS_S3_BUCKET_REGION=us-east-1
# CDN_BASE_URL=https://your-cloudfront-domain.cloudfront.net

# SMS Service Configuration
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=WnJOc1lEbU9McHl4YURZdWVleE4
ARKESEL_SENDER_ID="AGOSA EC"
ARKESEL_SANDBOX=false  # Set to false for production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Production environment variables
# NODE_ENV=production
# FRONTEND_URL=https://yourdomain.com