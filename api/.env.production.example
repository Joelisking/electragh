# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this to .env.production and update with your actual values

# ================================
# DATABASE CONFIGURATION
# ================================
# Use your managed PostgreSQL database URL
DATABASE_URL=postgresql://username:password@your-db-host:5432/voting?schema=public

# ================================
# SECURITY CONFIGURATION
# ================================
# CRITICAL: Generate new secrets for production
# Use: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_GENERATE_RANDOM_32_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_GENERATE_DIFFERENT_32_CHAR_STRING

# ================================
# SERVER CONFIGURATION
# ================================
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# ================================
# SMS SERVICE CONFIGURATION
# ================================
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=your_production_arkesel_api_key_here
ARKESEL_SENDER_ID=YourSenderID
ARKESEL_SANDBOX=false

# International OTP Service (for WhatsApp)
INTERNATIONAL_OTP_URL=https://otp.joelak.dev

# ================================
# STORAGE CONFIGURATION
# ================================
# Option 1: AWS S3 (Recommended for production)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=voting-candidate-images-prod
AWS_S3_BUCKET_REGION=us-east-1
CDN_BASE_URL=https://your-cloudfront-domain.cloudfront.net

# Option 2: Self-hosted MinIO (if not using AWS)
# STORAGE_PROVIDER=minio
# AWS_ACCESS_KEY_ID=your_minio_access_key
# AWS_SECRET_ACCESS_KEY=your_minio_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=voting-candidate-images
# S3_ENDPOINT=https://your-minio-endpoint.com
# CDN_BASE_URL=https://your-minio-endpoint.com

# ================================
# RATE LIMITING & SECURITY
# ================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# LOGGING & MONITORING
# ================================
LOG_LEVEL=info

# ================================
# OPTIONAL: REDIS CONFIGURATION
# ================================
# If using Redis for sessions/caching
# REDIS_URL=redis://your-redis-host:6379

# ================================
# DEPLOYMENT SETTINGS
# ================================
# Set to true to seed database on startup (only for initial deployment)
SEED_DATABASE=false

# ================================
# EMAIL CONFIGURATION (Optional)
# ================================
# If implementing email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ================================
# WEBHOOK CONFIGURATION (Optional)
# ================================
# For external integrations
# WEBHOOK_SECRET=your_webhook_secret_for_verification