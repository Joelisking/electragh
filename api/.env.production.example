# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/voting?schema=public

# JWT Configuration - CHANGE THESE IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Server Configuration
PORT=4000
NODE_ENV=production

# Frontend URL - Your production frontend domain
FRONTEND_URL=https://your-domain.com

# AWS S3 Storage Configuration
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=voting-candidate-images
# Optional: CloudFront or CDN URL for faster image delivery
CDN_BASE_URL=https://your-cloudfront-url.cloudfront.net

# SMS Service Configuration
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID="Your Sender ID"
ARKESEL_SANDBOX=false

# Twilio Configuration (for international OTP verification)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# Site Manager Configuration - CHANGE THIS IN PRODUCTION
SITE_MANAGER_KEY=your-super-secret-site-manager-key-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Database Seeding (set to true only for first deployment)
SEED_DATABASE=false
